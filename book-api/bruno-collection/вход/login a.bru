meta {
  name: Login Admin
  type: http
  seq: 3
}

http {
  method: POST
  url: {{baseUrl}}/api/auth/login
  headers {
    Content-Type: application/json
  }
  
  body {
    {
      "username": "admin",
      "password": "qwerty123"
    }
  }
}

tests {
  const json = response.body;
  if (json.token) {
    setEnvVar("adminToken", json.token);
    console.log("Admin token saved:", json.token);
  }
}