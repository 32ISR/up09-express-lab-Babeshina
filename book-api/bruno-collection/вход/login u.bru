meta {
  name: Login
  type: http
  seq: 2
}

http {
  method: POST
  url: {{baseUrl}}/api/auth/login
  headers {
    Content-Type: application/json
  }
  
  body {
    {
      "username": "user",
      "password": "qwerty123"
    }
  }
}

tests {
  const json = response.body;
  if (json.token) {
    setEnvVar("token", json.token);
    console.log("Token saved:", json.token);
  }
}