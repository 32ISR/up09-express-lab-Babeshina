meta {
  name: Create Book
  type: http
  seq: 8
}

http {
  method: POST
  url: {{baseUrl}}/api/books
  headers {
    Content-Type: application/json
    Authorization: Bearer {{token}}
  }

  body {
    {
      "title": "Кружка",
      "author": "Арсений Микрофонов",
      "year": 2004,
      "genre": "Фантастика",
      "description": "кружки кружка кружок"
    }
  }
}

tests {
  const book = response.body;
  if (book.id) {
    console.log("Book created with ID:", book.id);
    setEnvVar("newBookId", book.id);
  }
}