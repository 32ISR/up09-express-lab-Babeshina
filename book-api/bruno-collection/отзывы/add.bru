meta {
  name: Add Review
  type: http
  seq: 11
}

http {
  method: POST
  url: {{baseUrl}}/api/books/1/reviews
  headers {
    Content-Type: application/json
    Authorization: Bearer {{token}}
  }
  body {
    {
      "rating": 5,
      "comment": "Кружки топ!"
    }
  }
}

tests {
  const review = response.body;
  if (review.id) {
    console.log("Review added with ID:", review.id);
    setEnvVar("newReviewId", review.id);
  }
}